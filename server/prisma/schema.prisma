datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
 // directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}



enum UserRole {
  User
  Admin
}

//TODO store an array of void function and character string along with the emplacement in which they are used to simulate talents
model User {
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  id           String    @id @default(uuid())
  name         String    @db.VarChar(60)

  email        String    @unique
  password     String

  gameChatHistory  ChatMessage[]

//  location     Json?
//  isAdult      Boolean   @default(false)

  isOnline     Boolean?  @default(false)
  role         UserRole? @default(User)

  refreshToken String?
}

model ChatMessage {
  id                Int     @id @default(autoincrement())

  createdAt         DateTime @default(now())
  modifiedAt        DateTime @default(now()) @updatedAt

//  conv          Conversation @relation(fields: [convId], references: [id], onDelete: Cascade)
//  convId        Int     // relation scalar field (used in the `@relation` attribute above)

  user              User   @relation(fields: [userId], references: [id])
  userId            String

  characterName     String
  characterId       String

  content           String
}