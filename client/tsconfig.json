{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
//      "@backend/*": ["../server/*"]
    },
    // Enable latest features
    "lib": [
      "ESNext",
      "dom"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
//    "verbatimModuleSyntax": true,
    "declaration": false,                              /* Generate .d.ts files from TypeScript and JavaScript files in your project. */
    // Vite owns the build; `tsc -b` only typechecks. Required by
    // allowImportingTsExtensions, and keeps tsc from emitting stray .js.
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags
//    "noUnusedLocals": true,
//    "noUnusedParameters": true,
//    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["src"]
}
